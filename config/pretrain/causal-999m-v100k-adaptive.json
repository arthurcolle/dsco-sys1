{
  "schema": "sys1-pretrain-recipe-v1",
  "objective": "causal-next-token-cross-entropy",
  "description": "For new runs: bounded adaptive training mixture using representative validation and per-source training loss; evaluation objective remains fixed.",
  "expected_parameters": 998562562,
  "training": {
    "preset": "sys1-999m-v100k",
    "tokenizer": "data/tokenizer-100k/tokenizer.json",
    "corpus": "data/corpus",
    "mix": "en=0.5,code=0.3,agent=0.2",
    "seq": 1024,
    "micro-batch": 2,
    "accum": 8,
    "steps": 30000,
    "lr": 0.0003,
    "warmup": 500,
    "precision": "bf16",
    "ckpt-every": 200,
    "keep": 3,
    "eval-every": 200,
    "eval-seqs": 256,
    "log-every": 10,
    "seed": 1234,
    "early-stop-patience": 8,
    "early-stop-min-delta": 0.01,
    "validation-sampling": "reservoir",
    "max-domain-regression": 0.15,
    "domain-regression-patience": 4,
    "mixture-policy": "adaptive",
    "mixture-warmup": 3,
    "mixture-smoothing": 0.3,
    "mixture-rate": 1.0,
    "mixture-max-factor": 2.0,
    "mixture-max-change": 0.02,
    "mixture-min-observations": 32
  }
}
